  .gsap-reveal { visibility: hidden; }

  .film-grain {
    position: absolute; inset: 0; width: 100%; height: 100%;
    pointer-events: none; z-index: 50; opacity: 0.04; mix-blend-mode: overlay;
    background: url('data:image/svg+xml;utf8,<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"><filter id="noiseFilter"><feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(%23noiseFilter)"/></svg>');
  }

  .bg-grid-midia {
    background-size: 60px 60px;
    background-image:
      linear-gradient(to right, rgba(255,31,142,0.12) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,31,142,0.12) 1px, transparent 1px);
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
  }

  .text-midia-reveal {
    color: #0a0a0a;
    text-shadow:
      0 10px 40px rgba(255,31,142,0.15),
      0 2px 4px rgba(255,31,142,0.08);
  }

  .text-midia-grad {
    background: linear-gradient(135deg, #FF1F8E 0%, #FF6B35 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    transform: translateZ(0);
    filter:
      drop-shadow(0px 8px 20px rgba(255,31,142,0.25))
      drop-shadow(0px 2px 4px rgba(255,107,53,0.15));
  }

  .premium-depth-card-midia {
    background: linear-gradient(145deg, #1a0a12 0%, #080010 100%);
    box-shadow:
      0 40px 100px -20px rgba(0, 0, 0, 0.9),
      0 20px 40px -20px rgba(0, 0, 0, 0.8),
      inset 0 1px 2px rgba(255, 31, 142, 0.15),
      inset 0 -2px 4px rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(255, 31, 142, 0.08);
    position: relative;
  }

  .card-sheen-midia {
    position: absolute; inset: 0; border-radius: inherit; pointer-events: none; z-index: 50;
    background: radial-gradient(800px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,31,142,0.06) 0%, transparent 40%);
    mix-blend-mode: screen; transition: opacity 0.3s ease;
  }

  .floating-ui-badge-midia {
    background: linear-gradient(135deg, rgba(255,31,142,0.1) 0%, rgba(255,107,53,0.05) 100%);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow:
      0 0 0 1px rgba(255,31,142,0.2),
      0 25px 50px -12px rgba(0, 0, 0, 0.8),
      inset 0 1px 1px rgba(255,31,142,0.15),
      inset 0 -1px 1px rgba(0,0,0,0.5);
  }

  .btn-cta-primary {
    background: linear-gradient(135deg, #FF1F8E 0%, #FF6B35 100%);
    color: #fff;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    box-shadow: 0 4px 24px rgba(255,31,142,0.4);
  }
  .btn-cta-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 40px rgba(255,31,142,0.6);
  }

  .btn-cta-outline {
    background: transparent;
    color: #0a0a0a;
    border: 2px solid rgba(0,0,0,0.18);
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .btn-cta-outline:hover {
    border-color: #FF1F8E;
    color: #FF1F8E;
    box-shadow: 0 0 20px rgba(255,31,142,0.2);
    transform: translateY(-2px);
  }

  .stat-glow {
    background: rgba(255,31,142,0.06);
    border: 1px solid rgba(255,31,142,0.2);
    border-radius: 12px;
    padding: 12px 20px;
  }
